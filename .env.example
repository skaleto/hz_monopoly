NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://skbaby.top
BASE_PATH=/hangzhou-partners
DB_FILE=/data/game.db
APP_SECRET=replace-with-at-least-32-random-bytes

# dev: returns DEV_SMS_CODE to the browser; never expose publicly without access control.
# production: currently fails closed until a real SMS adapter is configured.
SMS_MODE=dev
DEV_SMS_CODE=123456
RECONNECT_GRACE_MS=60000

# Strongly recommended while SMS_MODE=dev. Opening /?access=<key> sets a 7-day HttpOnly gate cookie.
DEMO_ACCESS_KEY=replace-with-a-random-demo-access-key
